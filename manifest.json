{
  "manifest_version": 3,
  "name": "GarticPhone AdBlocker - Ultra",
  "version": "3.0",
  "description": "Блокировка 250+ рекламных сетей на GarticPhone",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.garticphone.com/*",
    "*://*.gartic.io/*",
    "*://*.gartic.com/*",
    "*://*.gartic.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.garticphone.com/*",
        "*://*.gartic.io/*",
        "*://*.gartic.com/*",
        "*://*.gartic.com.br/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}